// --- VARIABLES DE LA SLIME METÁLICA ---
hsp = -1.5;            // Velocidad horizontal de desplazamiento en el salto
vsp = 0;              // Velocidad vertical
grav = 0.3;           // Gravedad del slime
vel_salto_rebote = -5;// Fuerza del impulso hacia arriba al tocar el suelo
hp = 30;            // ajusta por enemigo (Avatar 60, Dryad 20, etc.)
hit_next = 0;       // evita que un solo golpe le pegue varias veces